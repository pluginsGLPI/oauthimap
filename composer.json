{
    "require": {
        "php": ">=8.2"
    },
    "provide": {
        "guzzlehttp/guzzle": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true,
        "autoloader-suffix": "PluginOauthimap"
    },
    "autoload-dev": {
        "psr-4": {
            "Glpi\\Tools\\": "../../tools/src/"
        }
    }
}
